{% if include.id %}
  {% assign gallery = page[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

{% if include.layout %}
  {% assign gallery_layout = include.layout %}
{% endif %}


{% if gallery_layout  == 'slides' %}
{% assign galleryfirstImg = gallery[0].image_path %}
<figure class="gallery slides">
  <ul>
    {% for img in gallery %}
      <li {% if forloop.index == 1 %} class="active" {% endif %} onclick="extendImg(this)">
        <img src="{{ img.image_path | relative_url }}" alt="{% if img.alt %}{{ img.alt }}{% endif %}">
      </li>
    {% endfor %}
  </ul>
  {% if include.caption %}
    <figcaption><h4>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</h4></figcaption>
  {% endif %}
</figure>
{% else %}
  <figure class="gallery {{ gallery_layout }}">
    {% for img in gallery %}
      {% if img.url %}
        <a href="{{ img.url | relative_url }}" title="{% if img.title %}{{ img.title }}{% endif %}">
          <img src="{{ img.image_path | relative_url }}" alt="{% if img.alt %}{{ img.alt }}{% endif %}">
        </a>
      {% elsif img.title %}
        <img src="{{ img.image_path | relative_url }}" alt="{% if img.alt %}{{ img.alt }}{% endif %}">
      {% else %}
        <img src="{{ img.image_path | relative_url }}" alt="{% if img.alt %}{{ img.alt }}{% endif %}">
      {% endif %}
    {% endfor %}
    {% if include.caption %}
      <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
    {% endif %}
  </figure>
{% endif %}

